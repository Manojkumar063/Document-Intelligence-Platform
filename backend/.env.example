# ─── App ───────────────────────────────────────────────────────────────────────
APP_NAME="RAG Application"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT=development

# ─── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# ─── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model output dimension — text-embedding-3-small = 1536
VECTOR_DIMENSION=1536
QDRANT_URL=http://localhost:6333

# ─── RAG ───────────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
RERANKING_ENABLED=false

# ─── File Storage ──────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ─── S3 (only needed when STORAGE_BACKEND=s3) ──────────────────────────────────
# Prefer an IAM role or AWS profile; static credentials are optional.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
S3_BUCKET=

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
